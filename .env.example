# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored and exists only on your machine, which is the point
# — and also means that if it is lost there is no copy to restore from. This
# file is the list of what it has to contain, so rebuilding it is a matter of
# fetching three values rather than remembering which names the code reads.
#
# EXPO_PUBLIC_ is not a suggestion: Expo only passes variables with that prefix
# into the app, and it marks them as shipping inside the bundle. Nothing secret
# belongs in any of these. Each one below is a public, restricted, client-side
# key; the secrets they pair with (the Supabase service role key, the Stripe
# secret key) live in Supabase's own secret storage and never in this repo.

# Supabase → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API Keys → publishable key (sb_publishable_...).
# Safe in a client: every table it can reach is behind row-level security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → APIs & Services → Credentials.
# Restrict it to exactly three APIs — Places API, Places API (New), and Cloud
# Translation API — and to this app's bundle id. The restrictions are the
# protection; the key itself ships in the app and cannot be kept private.
EXPO_PUBLIC_GOOGLE_API_KEY=

# Stripe, for paid event tickets. Not set up yet — payments are parked until
# there is a registered business and a domain. See PAYMENTS.md.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APPLE_MERCHANT_ID=
